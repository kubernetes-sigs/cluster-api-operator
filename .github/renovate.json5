{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'security:gomodIndirectSecurityUpdates',
    ':gitSignOff',
    ':prHourlyLimitNone',
  ],
  commitMessagePrefix: ':seedling: ',
  labels: [
    'ok-to-test',
  ],
  enabledManagers: [
    'gomod',
    'github-actions',
  ],
  dependencyDashboard: {
    labels: [
      'lifecycle/frozen',
    ],
  },
  gitIgnoredAuthors: [
    '41898282+github-actions[bot]@users.noreply.github.com',
  ],
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/examples/**',
    '**/__tests__/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  packageRules: [
    {
      description: 'Group GitHub Actions updates into one pull request on Mondays (UTC).',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'GitHub Actions',
      schedule: [
        '* * * * 1',
      ],
    },
    {
      description: 'New golangci-lint versions can need code fixes, so they get their own pull request.',
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        'golangci/golangci-lint',
      ],
      groupName: 'golangci-lint',
    },
    {
      description: 'Open Go module updates on the first day of the month (UTC).',
      matchManagers: [
        'gomod',
      ],
      schedule: [
        '* * 1 * *',
      ],
    },
    {
      description: 'Group Kubernetes patch updates.',
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'k8s.io/**',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'k8s.io',
    },
    {
      description: 'Group Cluster API modules, which are released together.',
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'sigs.k8s.io/cluster-api',
        'sigs.k8s.io/cluster-api/**',
      ],
      groupName: 'cluster-api',
    },
    {
      description: 'Group ginkgo and gomega.',
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'github.com/onsi/**',
      ],
      groupName: 'ginkgo',
    },
    {
      description: 'Major updates usually change the import path and need code changes, so they open only after approval on the Dependency Dashboard.',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Ordinary updates of tool modules stay manual. Vulnerability fixes still open, because those alerts override enabled: false.',
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'hack/tools/go.mod',
        'hack/chart-update/go.mod',
      ],
      enabled: false,
    },
    {
      description: 'Major, minor and pseudo-version (digest) updates are applied manually together with Cluster API and controller-runtime.',
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'k8s.io/**',
        'sigs.k8s.io/cluster-api',
        'sigs.k8s.io/cluster-api/**',
        'sigs.k8s.io/controller-runtime',
        'go.etcd.io/**',
        'google.golang.org/grpc',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'digest',
      ],
      enabled: false,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    addLabels: [
      'area/security',
    ],
  },
}
